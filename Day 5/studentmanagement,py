def student_management_system():
    # Dictionary to store students where the key is the Roll Number
    students = {}

    while True:
        print("\n--- Student Management System ---")
        print("1. Add / Update Student")
        print("2. View All Students")
        print("3. Search Student by Roll Number")
        print("4. Delete Student")
        print("5. Exit")

        choice = input("Enter your choice (1-5): ").strip()

        if choice == '1':
            roll_no = input("Enter Roll Number: ").strip()
            name = input("Enter Student Name: ").strip()
            age = input("Enter Age: ").strip()
            course = input("Enter Course: ").strip()

            # Storing student details as a nested dictionary
            students[roll_no] = {
                "Name": name,
                "Age": age,
                "Course": course
            }
            print(f"Student {name} added/updated successfully!")

        elif choice == '2':
            if not students:
                print("No student records found.")
            else:
                print("\n--- All Students List ---")
                for roll, details in students.items():
                    print(f"Roll No: {roll}")
                    for key, value in details.items():
                        print(f"  {key}: {value}")
                    print("-" * 20)

        elif choice == '3':
            roll_no = input("Enter Roll Number to search: ").strip()
            if roll_no in students:
                print(f"\nStudent Found (Roll No: {roll_no}):")
                for key, value in students[roll_no].items():
                    print(f"  {key}: {value}")
            else:
                print("Student with this Roll Number not found.")

        elif choice == '4':
            roll_no = input("Enter Roll Number to delete: ").strip()
            if roll_no in students:
                del students[roll_no]
                print(f"Student with Roll No {roll_no} deleted successfully.")
            else:
                print("Student not found.")

        elif choice == '5':
            print("Exiting Student Management System. Goodbye!")
            break
        else:
            print("Invalid choice! Please enter a number between 1 and 5.")

# Run the program
if __name__ == "__main__":
    student_management_system()